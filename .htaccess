<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    # Force all requests to go to the public directory
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Protect the .env file from being viewed
<Files .env>
    Order allow,deny
    Deny from all
</Files>
